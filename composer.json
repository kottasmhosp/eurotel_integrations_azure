{
    "type": "project",
    "license": "proprietary",
    "require": {
        "symfony/flex": "^2.4.7",
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "beberlei/doctrineextensions": "^v1.5.0",
        "doctrine/annotations": "*",
        "doctrine/dbal": "^3",
        "doctrine/doctrine-bundle": "^2.12",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "*",
        "dompdf/dompdf": "^3.0.0",
        "google/cloud-logging": "^v1.30.3",
        "google/cloud-storage": "^1.11",
        "guzzlehttp/guzzle": "^7.0",
        "lexik/jwt-authentication-bundle": "^v3.1.0",
        "php-amqplib/php-amqplib": "^3.7",
        "stolt/json-lines": "^2.0",
        "symfony/apache-pack": "^1.0",
        "symfony/cache": "^6.4",
        "symfony/config": "^6.4",
        "symfony/console": "^6.4",
        "symfony/dotenv": "*",
        "symfony/event-dispatcher": "6.4.*",
        "symfony/framework-bundle": "^6.4",
        "symfony/property-access": "6.4.*",
        "symfony/property-info": "6.4.*",
        "symfony/serializer": "^6.4",
        "symfony/yaml": "^6.4",
        "ext-curl": "*"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "6.4.*"
        }
    },
    "require-dev": {
        "symfony/maker-bundle": "^1.61.0"
    }
}
